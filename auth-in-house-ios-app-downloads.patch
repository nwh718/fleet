From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Fleet Maintainer <maintainer@fleetdm.com>
Date: Wed, 6 Jun 2026 00:00:00 +0000
Subject: [PATCH] Add defensive check for in-house app install token expiration

This change adds a defensive application-layer check to verify
that an in-house iOS app install token hasn't expired, even though
the database query already filters out expired tokens. This improves
defensive programming and provides better logging.
---
 ee/server/service/in_house_apps.go | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/ee/server/service/in_house_apps.go b/ee/server/service/in_house_apps.go
index 1234567..89abcde 100644
--- a/ee/server/service/in_house_apps.go
+++ b/ee/server/service/in_house_apps.go
@@ -7,6 +7,7 @@ import (
 	"fmt"
 	"strings"
 	"text/template"
+	"time"
 
 	"github.com/fleetdm/fleet/v4/server/contexts/ctxerr"
 	"github.com/fleetdm/fleet/v4/server/contexts/viewer"
@@ -316,6 +317,18 @@ func (svc *Service) validateInHouseAppInstallToken(
 		return nil, ctxerr.Wrap(ctx, err, "lookup in-house app install token")
 	}
 
+	// Defensive check: verify token hasn't expired, even though the database
+	// query should already have filtered out expired tokens.
+	if meta.ExpiresAt.Before(time.Now().UTC()) {
+		svc.logger.WarnContext(ctx, "in-house app install token expired",
+			"title_id", urlTitleID,
+			"host_id", meta.HostID,
+			"expires_at", meta.ExpiresAt)
+		return nil, fleet.NewPermissionError("invalid token")
+	}
+
 	if meta.SoftwareTitleID != urlTitleID {
 		svc.logger.WarnContext(ctx, "in-house app install token title mismatch",
 			"url_title_id", urlTitleID,
-- 
